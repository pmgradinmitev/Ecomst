@model ProductGalleryViewModel

<div class="row">
    <div class="col-12">
        <ul class="nav nav-tabs">
            @foreach (var item in Model.CategoryList)
            {
                string active = !String.IsNullOrEmpty(Model.CategoryName) && Model.CategoryName.ToUpper() == item.Name.ToUpper() ? "active" : "";
                <li class="nav-item">
                    <a asp-controller="Product" asp-action="Index" asp-route-CategoryName="@item.Name" class="nav-link @active">@item.Name</a>
                </li>
            }
        </ul>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-6 g-2 mt-3">
    @foreach (var item in Model.Data)
    {
        <div class="col">
            <a asp-controller="Product" asp-action="View" style="color:#212529; text-decoration:none;">
                <div class="card card-hover-effect h-100">
                    <div class="p-2">
                        <img src="@Url.Content("~/" + item.ThumbnailImagePath)" class="card-img-top" alt="...">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text">@Utils.GetSubstringWithWords(item.Description, 10)...</p>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-outline-secondary form-control">Виж повече</button>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="row mt-3">
    <div class="col-12 d-flex">
        <!--Utilities Spacing -->
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-start m-0">
                @{
                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                }
                <li class="page-item @prevDisabled">
                    <a asp-action="Index"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-CategoryName="@(Model.CategoryName)"
                       class="page-link" tabindex="-1">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @nextDisabled">
                    <a asp-action="Index"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-CategoryName="@(Model.CategoryName)"
                       class="page-link" tabindex="-1">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>
